=== MUTATION A: the six new paths set to 'allow read, write: if true;' ===
diff --git i/firestore.rules w/firestore.rules
index 9bff4b10..bc0dad96 100644
--- i/firestore.rules
+++ w/firestore.rules
@@ -329,0 +330,5 @@ service cloud.firestore {
+
+      // Señales de contacto: la escribe la API con Admin SDK; ni la propia cuenta la lee.
+      match /contactSignals/{docId} {
+        allow read, write: if true;
+      }
@@ -547,0 +553,31 @@ service cloud.firestore {
+    // ── Panel de negocios ───────────────────────────────────────────────────
+    //
+    // El panel lee y escribe todo esto a través de la API, nunca contra
+    // Firestore. Un `biz` o un `admin` en el token no abre ninguna de estas
+    // puertas desde un cliente.
+
+    // Quién es dueño de qué y desde cuándo: la escribe la API con Admin SDK.
+    match /ownerships/{ownershipId} {
+      allow read, write: if true;
+    }
+
+    // Preferencias y términos del dueño: los escribe la API con Admin SDK.
+    match /owners/{uid} {
+      allow read, write: if true;
+    }
+
+    // Invitaciones a dueños: las escribe la API con Admin SDK.
+    match /ownerInvitations/{invitationId} {
+      allow read, write: if true;
+    }
+
+    // Bitácora de cambios del dueño a su ficha: la escribe la API con Admin SDK.
+    match /profileEdits/{editId} {
+      allow read, write: if true;
+    }
+
+    // Reportes mensuales enviados: los escribe la API con Admin SDK.
+    match /monthlyReports/{reportId} {
+      allow read, write: if true;
+    }
+

