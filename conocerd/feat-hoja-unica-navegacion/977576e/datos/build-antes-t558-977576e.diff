-/// Lo que dibuja la capa de legs futuros. [route] es la ruta que falta desde
-/// la parada actual, con el leg en curso al principio ([currentLeg]). Con la
-/// llegada confirmada ([arrived]) ese leg ya se cumplió y no se dibuja: quedan
-/// los legs que le siguen (nada, si era el último). Sin llegada, o si [route]
-/// no empieza por [currentLeg], es la ruta entera.
-///
-/// La cola siempre arranca en la parada. Mapbox une los legs sin repetirla
-/// (`MapboxDirectionsService._assembleResult` salta el primer punto de cada leg
-/// posterior), así que tras cortar el leg cumplido la cola empezaba un segmento
-/// después del pin, y un leg siguiente de dos puntos quedaba en uno solo: se
-/// empalma con la parada, y si la unión ya la repetía no se toca.
-List<LatLng> futureRoutePoints(
-  List<LatLng> route, {
-  required List<LatLng> currentLeg,
-  required bool arrived,
-}) {
-  final n = currentLeg.length;
-  if (!arrived || n == 0 || route.length < n) return route;
-  if (route.first != currentLeg.first || route[n - 1] != currentLeg.last) {
-    return route;
-  }
-  final tail = route.sublist(n);
-  if (tail.isEmpty) return const [];
-  final stop = currentLeg.last;
-  final rest = tail.first == stop ? tail : [stop, ...tail];
-  return rest.length < 2 ? const [] : rest;
-}
